<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="courselignedroite.menu.ControlleurSaisieJoueurs"
           stylesheets="@../menu/style/menu.css"
           prefWidth="800" prefHeight="600">

    <Pane styleClass="background-pane"/>

    <VBox alignment="CENTER" spacing="0" styleClass="main-container">

        <!-- Titre -->
        <VBox alignment="CENTER" spacing="6" styleClass="title-block">
            <HBox alignment="CENTER" spacing="8">
                <Line startX="0" endX="120" styleClass="deco-line"/>
                <Label text="✦" styleClass="deco-star"/>
                <Line startX="0" endX="120" styleClass="deco-line"/>
            </HBox>
            <Label text="⚔  NOUVELLE PARTIE" styleClass="title-main"/>
            <Label text="Entrez vos pseudonymes" styleClass="title-sub"/>
            <HBox alignment="CENTER" spacing="8">
                <Line startX="0" endX="120" styleClass="deco-line"/>
                <Label text="✦" styleClass="deco-star"/>
                <Line startX="0" endX="120" styleClass="deco-line"/>
            </HBox>
        </VBox>

        <Region prefHeight="36"/>

        <!-- Formulaire saisie -->
        <VBox alignment="CENTER" spacing="20" styleClass="saisie-container">

            <!-- Joueur 1 -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="🔴  JOUEUR 1" styleClass="saisie-label"/>
                <TextField fx:id="tfJoueur1"
                           promptText="Pseudo du joueur 1"
                           styleClass="saisie-field"
                           prefWidth="320"/>
                <Label fx:id="errJoueur1" styleClass="saisie-erreur" text="" managed="false" visible="false"/>
            </VBox>

            <!-- Joueur 2 -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="🔵  JOUEUR 2" styleClass="saisie-label"/>
                <TextField fx:id="tfJoueur2"
                           promptText="Pseudo du joueur 2"
                           styleClass="saisie-field"
                           prefWidth="320"
                          />
                <Label fx:id="errJoueur2" styleClass="saisie-erreur" text="" managed="false" visible="false"/>
            </VBox>

        </VBox>

        <Region prefHeight="36"/>

        <!-- Boutons -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="← RETOUR"
                    styleClass="btn-menu, btn-secondary"
                    prefWidth="200"
                    onAction="#handleRetour"/>
            <Button text="JOUER ⚔"
                    styleClass="btn-menu, btn-primary"
                    prefWidth="200"
                    onAction="#handleJouer"/>
        </HBox>

        <Region prefHeight="16"/>
        <Label text="IUT de Rodez · BUT Informatique · 2025-2026" styleClass="footer-label"/>

    </VBox>

</StackPane>
