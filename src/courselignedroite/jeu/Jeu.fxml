<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
  Plateau :
    Ligne 0 (haut)  = BLEU   (arrivée col 1,  réserve droite)
    Ligne 1 (bas)   = ROUGE  (arrivée col 12, réserve gauche)
    Ligne 2         = numéros de cases

  fx:id racineJeu → porte la classe de palette (.palette-bleuRouge …)
  fx:id fondPane  → porte la classe de fond de l'interface (.fond-bois …)
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="racineJeu"
      fx:controller="courselignedroite.jeu.ControlleurJeu"
      stylesheets="@../menu/style/menu.css, @jeu.css"
      prefWidth="900" prefHeight="660">

    <!-- ── Barre de menus en jeu ── -->
    <MenuBar fx:id="menuBar">
        <Menu text="Partie">
            <MenuItem text="Sauvegarder"       onAction="#handleSauvegarder"/>
            <SeparatorMenuItem/>
            <MenuItem text="Règles du jeu"     onAction="#handleRegles"/>
            <SeparatorMenuItem/>
            <MenuItem text="Quitter la partie" onAction="#handleQuitter"/>
        </Menu>
    </MenuBar>

    <!-- ── Fond + contenu ── -->
    <StackPane VBox.vgrow="ALWAYS">

        <!-- Panneau de fond : reçoit la classe .fond-bois / .fond-nuit / .fond-clair -->
        <Pane fx:id="fondPane" styleClass="fond-bois"/>

        <VBox alignment="CENTER" spacing="0" styleClass="main-container">

            <!-- Titre -->
            <HBox alignment="CENTER" spacing="8">
                <Label text="✦" styleClass="deco-star"/>
                <Label text="LA COURSE EN LIGNE DROITE" styleClass="title-main"
                       style="-fx-font-size:20px;"/>
                <Label text="✦" styleClass="deco-star"/>
            </HBox>

            <Region prefHeight="10"/>

            <!-- Infos joueurs -->
            <HBox alignment="CENTER" spacing="40">
                <Label fx:id="lblInfoRouge"
                       style="-fx-text-fill:#EF9A9A;-fx-font-family:Georgia;
                              -fx-font-size:13px;-fx-font-weight:bold;" text="Joueur Rouge"/>
                <VBox alignment="CENTER" spacing="4"
                      style="-fx-background-color:rgba(212,160,23,0.12);
                             -fx-border-color:rgba(212,160,23,0.4);-fx-border-width:1;
                             -fx-border-radius:6;-fx-background-radius:6;-fx-padding:6 20 6 20;">
                    <Label fx:id="lblTour"
                           style="-fx-text-fill:#F0C94A;-fx-font-family:Georgia;
                                  -fx-font-size:13px;-fx-font-weight:bold;" text="Tour de : —"/>
                    <Label fx:id="lblDe"
                           style="-fx-text-fill:#F0C94A;-fx-font-family:Georgia;
                                  -fx-font-size:30px;-fx-font-weight:bold;" text="—"/>
                </VBox>
                <Label fx:id="lblInfoBleu"
                       style="-fx-text-fill:#90CAF9;-fx-font-family:Georgia;
                              -fx-font-size:13px;-fx-font-weight:bold;" text="Joueur Bleu"/>
            </HBox>

            <Region prefHeight="12"/>

            <!-- Plateau + réserves -->
            <HBox alignment="CENTER" spacing="10">

                <!-- Réserve Rouge (gauche) -->
                <VBox alignment="CENTER" spacing="6" styleClass="reserve-rouge">
                    <Label text="Réserve" styleClass="lbl-reserve-rouge"/>
                    <Label text="ROUGE"   styleClass="lbl-reserve-rouge"/>
                    <HBox fx:id="reserveRouge" alignment="CENTER" spacing="4"/>
                </VBox>

                <!-- Plateau central : reçoit la classe .plateau-classique / .plateau-pierre / .plateau-vert -->
                <GridPane fx:id="gridPlateau"
                          hgap="2" vgap="2" alignment="CENTER"
                          styleClass="plateau-classique"/>

                <!-- Réserve Bleu (droite) -->
                <VBox alignment="CENTER" spacing="6" styleClass="reserve-bleu">
                    <Label text="Réserve" styleClass="lbl-reserve-bleu"/>
                    <Label text="BLEU"    styleClass="lbl-reserve-bleu"/>
                    <HBox fx:id="reserveBleu" alignment="CENTER" spacing="4"/>
                </VBox>

            </HBox>

            <!-- Légende -->
            <HBox alignment="CENTER" spacing="60">
                <Label text="← Bleus  (droite vers gauche)"
                       style="-fx-text-fill:#90CAF9;-fx-font-size:11px;-fx-font-style:italic;"/>
                <Label text="Rouges  (gauche vers droite) →"
                       style="-fx-text-fill:#EF9A9A;-fx-font-size:11px;-fx-font-style:italic;"/>
            </HBox>

            <Region prefHeight="10"/>

            <!-- Message contextuel -->
            <Label fx:id="lblMessage"
                   style="-fx-text-fill:#F5EDD3;-fx-font-family:Georgia;
                          -fx-font-size:13px;-fx-font-style:italic;"
                   wrapText="true" maxWidth="700" text="" alignment="CENTER"/>

            <Region prefHeight="10"/>

            <!-- Bouton lancer -->
            <HBox alignment="CENTER">
                <Button fx:id="btnLancer"
                        text="LANCER LE DÉ"
                        styleClass="btn-menu, btn-primary"
                        prefWidth="200"
                        onAction="#handleLancer"/>
            </HBox>

            <Region prefHeight="8"/>
            <Label text="IUT de Rodez · BUT Informatique · 2025-2026"
                   styleClass="footer-label"/>

        </VBox>
    </StackPane>

</VBox>
